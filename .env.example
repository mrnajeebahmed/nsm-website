# ── LLM Gateway ─────────────────────────────────────────────
# Primary provider: openai | anthropic | gemini
DEFAULT_LLM_PROVIDER=anthropic
# Comma-separated failover order tried after the primary fails/times out
LLM_FALLBACK_ORDER=openai,gemini
LLM_TIMEOUT_MS=20000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Lead capture ────────────────────────────────────────────
# POST target for leads (HubSpot/Salesforce/n8n/Make/Zapier webhook)
LEAD_WEBHOOK_URL=
# Booking link returned to visitors after a call is requested
BOOKING_URL=https://cal.com/nsm-technologies/strategy-call
